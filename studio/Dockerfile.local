####################################################################
# MIVAIS Studio — LOCAL docker-compose image (PODIUM as unit-under-test).
#
# Used by ../docker-compose.yml. Unlike the Kubernetes image built from
# ./Dockerfile, this one bundles the Docker CLI + compose plugin so Studio can
# spawn the VA under test (PODIUM) via `docker compose up` against the mounted
# host socket (compose-spawn mode). Studio, Mongo and the spawned PODIUM all
# run as sibling containers on the host daemon.
#
# Build context is this directory (study-environment-main/studio).
####################################################################

# Pull a static Docker CLI + the compose/buildx plugins from the official
# image and graft them onto the Python base. Avoids the apt-repo dance.
FROM docker:27-cli AS dockercli

FROM python:3.12-slim-bookworm AS base

# libsndfile1: needed at import time by `soundfile` (transitive dep).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI + cli-plugins (compose) from the dockercli stage. The plugin dir
# /usr/local/lib/docker/cli-plugins is one of the CLI's standard search paths.
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins /usr/local/lib/docker/cli-plugins

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Editable install: Studio loads templates/static/locales via __file__, so the
# package must stay in place on disk (mirrors `pip install -e .`).
COPY pyproject.toml README.md ./
COPY studio ./studio
COPY studies ./studies
RUN pip install --no-cache-dir -e .

ENV STUDIO_DATA_DIR=/app/data \
    STUDIO_STUDIES_DIR=/app/studies \
    STUDIO_MONGO_URL=mongodb://mongo:27017 \
    STUDIO_WHISPER_WORKER_ENABLED=false

EXPOSE 8000

# Single worker on purpose: tailer / VA spawner / Whisper worker keep
# in-process state.
CMD ["python", "-m", "uvicorn", "studio.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--log-level", "info"]
