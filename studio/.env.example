# Copy to .env and adjust.

# MongoDB
STUDIO_MONGO_URL=mongodb://localhost:27017
STUDIO_MONGO_DB=mivais_studio

# Admin login (single user in v0; multi-user comes later).
STUDIO_ADMIN_USERNAME=admin
STUDIO_ADMIN_PASSWORD=change-me

# JWT signing key. Generate a real one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STUDIO_JWT_SECRET=dev-only-change-me
STUDIO_JWT_TTL_MINUTES=720

# File system
STUDIO_DATA_DIR=./data
STUDIO_STUDIES_DIR=./studies

# Port range Studio uses when spawning VA subprocesses
STUDIO_VA_PORT_RANGE_START=7100
STUDIO_VA_PORT_RANGE_END=7199
STUDIO_VA_SPAWN_TIMEOUT_SECONDS=45
STUDIO_VA_SHUTDOWN_GRACE_SECONDS=5
